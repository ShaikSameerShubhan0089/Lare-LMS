# LARE production environment — copy to deploy/.env.production and fill in.
# NEVER commit the real file. On AWS, prefer loading these from Secrets Manager
# at deploy time (see the runbook) rather than leaving a plaintext file on disk.

# ---- Database: Amazon RDS for PostgreSQL (schema-per-service, 1 instance) ----
# URL-encode special chars in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://lare_admin:URLENCODED_PASSWORD@lare-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/lms

# Connection pool per service. 27 processes x (POOL + OVERFLOW) MUST stay under
# the RDS instance's max_connections. Keep these small; scale the DB, not these.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# ---- Identity (RS256). Keys are mounted at /app/backend/keys via compose. ----
JWT_ALG=RS256
JWT_PRIVATE_KEY_FILE=/app/backend/keys/jwt_priv.pem
JWT_PUBLIC_KEY_FILE=/app/backend/keys/jwt_pub.pem
JWT_SECRET=CHANGE_ME_LONG_RANDOM
INTERNAL_JWT_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM
ACCESS_TOKEN_TTL_MIN=240

APP_ENV=production

# ---- AI: Gemini for LMS, Mistral scoped to Drive (ROTATE the keys first) -----
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=4096
DRIVE_AI_PROVIDER=mistral
MISTRAL_API_KEY=CHANGE_ME_ROTATED
MISTRAL_MODEL=mistral-small-latest

# ---- Email: keep Zoho, or switch to Amazon SES (see runbook Phase 8) ---------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=info.market@lareitcloudsolutions.com
SMTP_FROM=info.market@lareitcloudsolutions.com
SMTP_PASSWORD=CHANGE_ME_ROTATED

# ---- Optional: files on S3 (leave blank to use local disk) -------------------
# AWS_REGION=ap-south-1
# S3_BUCKET=lare-lms-storage
