SERVICE_NAME=drive-coding
APP_ENV=development
DEBUG=true
PORT=8016
DATABASE_URL=sqlite:///coding.sqlite3
DB_SCHEMA=drive_coding
# Dev executor (subprocess + timeout). PRODUCTION: swap to an OS sandbox executor.
EXEC_ENABLED=true
EXEC_TIMEOUT_SEC=5
JWT_ALG=HS256
JWT_SECRET=dev-insecure-change-me
JWT_ISSUER=lare-auth
JWT_AUDIENCE=lare-platform
CORS_ORIGINS=*
