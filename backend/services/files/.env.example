SERVICE_NAME=lare-files
APP_ENV=development
DEBUG=true
PORT=8021
DATABASE_URL=sqlite:///files.sqlite3
DB_SCHEMA=shared_files
# Storage: 'local' (dev) or 'supabase' (prod)
STORAGE_BACKEND=local
STORAGE_DIR=_storage
UPLOAD_TOKEN_TTL_MIN=15
DOWNLOAD_TOKEN_TTL_MIN=10
JWT_ALG=HS256
JWT_SECRET=dev-insecure-change-me
JWT_ISSUER=lare-auth
JWT_AUDIENCE=lare-platform
CORS_ORIGINS=*
