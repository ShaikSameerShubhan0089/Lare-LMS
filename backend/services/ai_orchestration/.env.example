SERVICE_NAME=lms-ai
APP_ENV=development
DEBUG=true
PORT=8024
DATABASE_URL=sqlite:///ai_orchestration.sqlite3
DB_SCHEMA=lms_ai
# Leave ANTHROPIC_API_KEY empty for STUB mode; set it (and `pip install anthropic`)
# to enable live Claude responses. Model defaults to the latest Opus.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS=1024
AI_THINKING=adaptive
JWT_ALG=HS256
JWT_SECRET=dev-insecure-change-me
INTERNAL_JWT_SECRET=dev-internal-secret-change-me
JWT_ISSUER=lare-auth
JWT_AUDIENCE=lare-platform
CORS_ORIGINS=*
