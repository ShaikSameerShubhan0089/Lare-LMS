# /etc/lare/lare.env  — shared secrets + config for EVERY service (chmod 600).
# Copy to /etc/lare/lare.env and fill in real values. Never commit the real file.

# ---- Database (RDS Postgres). One cluster, schema-per-service. ----
DATABASE_URL=postgresql+psycopg://lareadmin:CHANGE_ME@lare-db.xxxxx.ap-south-1.rds.amazonaws.com:5432/lare

# ---- Event bus (Redis on this box or ElastiCache). Omit to use HTTP fan-out. ----
EVENT_BUS_BACKEND=auto
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Identity / JWT (RS256 in production) ----
JWT_ALG=RS256
# Auth SIGNS with the private key; every service + gateway VERIFY with the public key.
# Paste the PEMs inline (keep the literal newlines):
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...auth only...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...everyone...\n-----END PUBLIC KEY-----
JWT_ISSUER=lare-auth
JWT_AUDIENCE=lare-platform
# Shared secret for internal service-to-service tokens (rotate this):
INTERNAL_JWT_SECRET=CHANGE_ME_LONG_RANDOM

# ---- App ----
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://lms.example.edu

# ---- Coding sandbox (nsjail/bubblewrap must be installed) ----
EXEC_MODE=sandbox

# ---- AI providers ----
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
DRIVE_AI_PROVIDER=mistral
MISTRAL_API_KEY=CHANGE_ME
AI_MAX_TOKENS=2048

# ---- Email / SMS (optional; default logs only) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=noreply@your-domain
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@your-domain
SMTP_TLS=true
# EMAIL_PROVIDER=brevo / BREVO_API_KEY / BREVO_FROM
# SMS_PROVIDER=twilio / TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM

# ---- Wallet credential signing (defaults to INTERNAL_JWT_SECRET if unset) ----
# WALLET_SIGNING_SECRET=CHANGE_ME
