# Procfile — run the whole platform with honcho/foreman (cross-platform, no Docker).
#   pip install honcho && honcho start
# Each manage.py `serve` binds its own default port (matches services.txt).
# Set shared secrets/DB/Redis in a sibling .env file (honcho auto-loads it):
#   JWT_SECRET=... INTERNAL_JWT_SECRET=... EVENT_BUS_BACKEND=http
#   (DATABASE_URL/REDIS_URL when moving to Supabase/Redis)
auth:           python services/auth/manage.py serve
institution:    python services/institution/manage.py serve
